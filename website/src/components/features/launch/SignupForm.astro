---
import { createTranslator, getLocaleFromUrl } from "@/utils/i18n";
import { WAITLIST_SOURCE, type WaitlistSource } from "@/constants/waitlist";

interface Props {
  /** Unique per instance; prefixes the input and error ids. */
  id: string;
  /** Which waitlist these signups belong to. */
  source?: WaitlistSource;
}

const { id, source = WAITLIST_SOURCE.LAUNCH } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const t = await createTranslator(locale);
---

<div class="launch-signup" data-launch-signup data-source={source}>
  <form class="launch-form" novalidate data-signup-form>
    <div class="launch-form-row">
      <input
        type="email"
        name="email"
        id={`${id}-email`}
        class="launch-input"
        placeholder={t("launch.signup.email_placeholder")}
        aria-label={t("launch.signup.email_aria")}
        aria-describedby={`${id}-error`}
        autocomplete="email"
        required
        data-signup-email
      />
      <button type="submit" class="launch-submit" data-signup-submit>
        {t("launch.signup.submit_label")}
      </button>
    </div>

    <span class="launch-error-msg" id={`${id}-error`} data-signup-error>
      {t("launch.signup.error_message")}
    </span>
  </form>

  {/* Receipt: the field becomes a confirmed row carrying the address. */}
  <div class="launch-receipt" hidden data-signup-success>
    <div class="launch-receipt-row">
      <span class="launch-receipt-mail" data-signup-mail></span>
      <span class="launch-receipt-check" aria-hidden="true">
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="square"
        >
          <path d="M1.5 6.3 4.4 9.2 10.5 3"></path>
        </svg>
      </span>
    </div>
    <p class="launch-receipt-line" data-signup-line>
      {t("launch.signup.success.headline")}
      {t("launch.signup.success.sub")}
    </p>
  </div>

  {/* Filled only in the instance that was submitted, so it announces once. */}
  <p class="launch-status" role="status" data-signup-status></p>
</div>

<style>
  .launch-signup {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .launch-form {
    transition: opacity 0.4s ease;
  }

  .launch-form.is-leaving {
    opacity: 0;
  }

  .launch-form-row {
    display: grid;
    grid-template-columns: 1fr auto;
  }

  .launch-input {
    width: 100%;
    min-width: 0;
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 300;
    padding: 21px 24px;
    background: color-mix(in srgb, var(--color-void) 90%, transparent);
    color: var(--color-content);
    border: 1px solid var(--color-flare);
    border-radius: 0;
  }

  .launch-input::placeholder {
    color: var(--color-content-60);
  }

  .launch-input:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-flare);
  }

  .launch-input[aria-invalid="true"] {
    border-color: rgba(255, 59, 59, 0.6);
    box-shadow: inset 0 0 0 1px rgba(255, 59, 59, 0.6);
  }

  .launch-submit {
    font-family: var(--font-primary);
    font-size: 14.5px;
    font-weight: 400;
    letter-spacing: 0.005em;
    white-space: nowrap;
    padding: 21px 40px;
    background: var(--color-flare);
    color: var(--color-void);
    border: 1px solid var(--color-flare);
    border-radius: 0;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.08s ease;
  }

  .launch-submit:hover {
    background: var(--launch-flare-hover);
    border-color: var(--launch-flare-hover);
  }

  .launch-submit:active {
    background: var(--launch-flare-pressed);
    border-color: var(--launch-flare-pressed);
    transform: translateY(1px);
  }

  .launch-submit:focus-visible {
    outline: 2px solid var(--color-content);
    outline-offset: 3px;
  }

  .launch-submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .launch-error-msg {
    display: none;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(255, 59, 59, 0.8);
    text-align: center;
  }

  .launch-error-msg.is-shown {
    display: block;
  }

  .launch-receipt {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .launch-receipt.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .launch-receipt-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 19px 20px;
    border: 1px solid var(--color-content-10);
    background: color-mix(in srgb, var(--color-void) 50%, transparent);
  }

  .launch-receipt-mail {
    min-width: 0;
    overflow: hidden;
    font-size: 15px;
    color: var(--color-content);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .launch-receipt-check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--color-flare);
    color: var(--color-void);
  }

  .launch-receipt-check svg {
    width: 11px;
    height: 11px;
  }

  .launch-receipt-line {
    margin: 20px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-content-70);
    text-align: center;
  }

  /* Visually hidden live region. */
  .launch-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-form,
    .launch-receipt,
    .launch-submit {
      transition: none;
    }

    .launch-submit:active {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .launch-input {
      padding: 15px 14px;
      font-size: 14px;
    }

    .launch-submit {
      padding: 15px 18px;
      font-size: 13.5px;
    }

    .launch-receipt-row {
      padding: 15px 14px;
    }

    .launch-receipt-mail,
    .launch-receipt-line {
      font-size: 14px;
    }
  }
</style>

<script>
  import apiClient from "@/api/client";
  import { trackEvent } from "@/scripts/shared/analytics";

  interface Signup {
    root: HTMLElement;
    form: HTMLFormElement;
    input: HTMLInputElement;
    submit: HTMLButtonElement;
    error: HTMLElement;
    success: HTMLElement;
    mail: HTMLElement;
    line: HTMLElement;
    status: HTMLElement;
  }

  const FORM_FADE_MS = 400;

  const isValidEmail = (val: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);

  const signups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-launch-signup]"),
  ).flatMap((root): Signup[] => {
    const q = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector);
    const parts = {
      root,
      form: q<HTMLFormElement>("[data-signup-form]"),
      input: q<HTMLInputElement>("[data-signup-email]"),
      submit: q<HTMLButtonElement>("[data-signup-submit]"),
      error: q<HTMLElement>("[data-signup-error]"),
      success: q<HTMLElement>("[data-signup-success]"),
      mail: q<HTMLElement>("[data-signup-mail]"),
      line: q<HTMLElement>("[data-signup-line]"),
      status: q<HTMLElement>("[data-signup-status]"),
    };
    return Object.values(parts).every(Boolean) ? [parts as Signup] : [];
  });

  const setLoading = (submit: HTMLButtonElement, loading: boolean) => {
    submit.disabled = loading;
    if (loading) {
      submit.dataset.originalText = submit.innerText;
      submit.innerText = "...";
    } else {
      submit.innerText = submit.dataset.originalText ?? "";
    }
  };

  const setInvalid = (signup: Signup, invalid: boolean) => {
    signup.input.setAttribute("aria-invalid", String(invalid));
    signup.error.classList.toggle("is-shown", invalid);
  };

  /** Every form on the page flips to the receipt, not just the one used. */
  const showReceipt = (email: string, submitted: Signup) => {
    for (const signup of signups) {
      signup.mail.textContent = email;
      signup.form.classList.add("is-leaving");
    }

    setTimeout(() => {
      for (const signup of signups) {
        signup.form.hidden = true;
        signup.success.hidden = false;
        requestAnimationFrame(() => signup.success.classList.add("is-shown"));
      }
      submitted.status.textContent = (submitted.line.textContent ?? "")
        .replace(/\s+/g, " ")
        .trim();
    }, FORM_FADE_MS);
  };

  for (const signup of signups) {
    const { root, form, input, submit } = signup;
    const source = root.dataset.source;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit.disabled) return;

      setInvalid(signup, false);

      const email = input.value.trim();

      if (!email || !isValidEmail(email)) {
        setInvalid(signup, true);
        return;
      }

      setLoading(submit, true);

      try {
        // The squeeze page collects email only; the API still expects the
        // name fields, so they go up empty.
        const resp = await apiClient.subscribe(email, "", "", source);
        const data = await resp.json();

        if (resp.status !== 201) {
          if (data.error) window.toast.error(data.error);
          setLoading(submit, false);
          return;
        }

        trackEvent("generate_lead", {
          lead_type: "launch",
          form_id: "launch_squeeze",
        });

        showReceipt(email, signup);
      } catch (error) {
        window.toast.error((error as Error).message);
        setLoading(submit, false);
      }
    });
  }
</script>
