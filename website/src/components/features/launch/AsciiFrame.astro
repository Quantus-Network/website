---
/**
 * ASCII edge framing for /launch.
 *
 * Uses the home hero's generator unchanged — renderASCIIRect over the
 * chladniRect field, same RAMP (" .,·:;|+x#"), same node-threshold density
 * gradient. One continuous field is generated for the whole section, then
 * sliced into four edge strips, so the pattern is the same one Home draws,
 * just framing the content instead of running full-bleed behind it.
 *
 * Character advance and line height are measured from a live probe rather
 * than estimated, so the strip geometry lands exactly and the left/right
 * insets stay symmetrical.
 */
---

<div class="ascii-frame" aria-hidden="true">
  <pre class="af-strip" data-edge="top"></pre>
  <pre class="af-strip" data-edge="bottom"></pre>
  <pre class="af-strip" data-edge="left"></pre>
  <pre class="af-strip" data-edge="right"></pre>
</div>

<style>
  .ascii-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .af-strip {
    position: absolute;
    margin: 0;
    font-family: "Geist Mono", monospace;
    font-size: 11px;
    line-height: 1.22;
    letter-spacing: 0.05em;
    white-space: pre;
    color: rgba(255, 107, 53, 0.22);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .af-strip {
      font-size: 6px;
      line-height: 1.15;
    }
  }
</style>

<script>
  import { RAMP } from "@/scripts/home/ascii";
  import { chladniRect } from "@/scripts/home/base-math";

  const frame = document.querySelector<HTMLElement>(".ascii-frame");
  const inner = document.querySelector<HTMLElement>(".launch-inner");
  const section = document.getElementById("launch");

  if (frame && inner && section) {
    const strips = {
      top: frame.querySelector<HTMLElement>('[data-edge="top"]')!,
      bottom: frame.querySelector<HTMLElement>('[data-edge="bottom"]')!,
      left: frame.querySelector<HTMLElement>('[data-edge="left"]')!,
      right: frame.querySelector<HTMLElement>('[data-edge="right"]')!,
    };

    /** Mode pair from the hero's MODES table; t=0 gives the symmetric figure. */
    const MODE_M = 2;
    const MODE_N = 3;
    const TIME = 0;

    /**
     * Ramp ceiling. The raw field pins to '#' along every nodal line, which
     * renders as solid diagonal runs; capping mid-ramp keeps those lines
     * legible as texture instead of blocks.
     */
    const MAX_IDX = 6;
    /** Share of field glyphs kept at the corners; dithered away elsewhere. */
    const COVERAGE = 1;
    /** Falloff exponent — higher pulls weight harder into the corners. */
    const CORNER_P = 1;

    /**
     * Deterministic dither in [0,1). Folded to the near corner so it is
     * identical in all four quadrants and cannot break the symmetry.
     */
    const dither = (col: number, row: number, cols: number, rows: number) => {
      const fc = Math.min(col, cols - 1 - col);
      const fr = Math.min(row, rows - 1 - row);
      const n = Math.sin(fc * 127.1 + fr * 311.7) * 43758.5453;
      return n - Math.floor(n);
    };

    /**
     * One cell of the field.
     *
     * The glyph comes from chladniRect on folded coordinates, so the pattern
     * mirrors about both axes — the raw field is only symmetric under 180°
     * rotation, which is what left top-left empty while top-right was heavy.
     * Coverage is then weighted by |x|·|y|, peaking at the four corners and
     * falling to nothing at each edge midpoint and at the centre.
     */
    const cell = (col: number, row: number, cols: number, rows: number) => {
      // Cell centres, not cell origins: (col/cols) is not the exact negation
      // of ((cols-1-col)/cols), and that half-cell offset breaks the mirror.
      const px = ((col + 0.5) / cols) * 2 - 1;
      const py = ((row + 0.5) / rows) * 2 - 1;
      const ax = Math.abs(px);
      const ay = Math.abs(py);

      const weight = Math.pow(ax, CORNER_P) * Math.pow(ay, CORNER_P);
      if (dither(col, row, cols, rows) > weight * COVERAGE) return " ";

      // Fold into one quadrant, then span the full plate across it.
      const v = chladniRect(2 * ax - 1, 2 * ay - 1, MODE_M, MODE_N, TIME);
      const a = Math.abs(v);
      const NODE = 0.12;

      let idx =
        a < NODE
          ? Math.floor((1 - a / NODE) * (RAMP.length - 1))
          : Math.max(0, Math.floor(((0.4 - a) / 0.4) * 2));

      idx = Math.min(Math.max(idx, 0), MAX_IDX);
      return RAMP[idx];
    };

    const block = (
      c0: number,
      c1: number,
      r0: number,
      r1: number,
      cols: number,
      rows: number,
    ) => {
      const lines: string[] = [];
      for (let r = r0; r < r1; r++) {
        let line = "";
        for (let c = c0; c < c1; c++) line += cell(c, r, cols, rows);
        lines.push(line);
      }
      return lines.join("\n");
    };

    /** Measure real glyph advance and line box from the rendered font. */
    const metrics = () => {
      const probe = document.createElement("span");
      probe.style.cssText =
        "position:absolute;visibility:hidden;white-space:pre;";
      probe.textContent = "x".repeat(100);
      strips.top.appendChild(probe);
      const chW = probe.getBoundingClientRect().width / 100;
      probe.remove();

      const cs = getComputedStyle(strips.top);
      let lh = parseFloat(cs.lineHeight);
      if (!Number.isFinite(lh)) lh = parseFloat(cs.fontSize) * 1.2;
      return { chW, lh };
    };

    const draw = () => {
      const { chW, lh } = metrics();
      if (!(chW > 0) || !(lh > 0)) return;

      const isMobile = window.innerWidth <= 768;
      const gutter = isMobile ? 16 : 28;

      const sect = section.getBoundingClientRect();
      const box = inner.getBoundingClientRect();
      const W = sect.width;
      const H = sect.height;

      const cols = Math.ceil(W / chW);
      const rows = Math.ceil(H / lh);
      if (cols < 2 || rows < 2) return;

      // Hole measured from the centre out, so both sides match exactly.
      const sideGap = Math.max(0, W / 2 - box.width / 2 - gutter);
      const vertGap = Math.max(0, H / 2 - box.height / 2 - gutter);
      const sideCols = Math.max(0, Math.floor(sideGap / chW));
      const edgeRows = Math.max(0, Math.floor(vertGap / lh));
      const midRows = rows - edgeRows;

      // Top and bottom: full width, equal row counts, anchored to each edge.
      strips.top.style.cssText = "top:0;left:0;";
      strips.top.textContent = block(0, cols, 0, edgeRows, cols, rows);

      strips.bottom.style.cssText = "bottom:0;left:0;";
      strips.bottom.textContent = block(0, cols, midRows, rows, cols, rows);

      // Sides: equal column counts anchored to opposite edges, so the inset
      // is symmetrical by construction.
      strips.left.style.cssText = `top:${edgeRows * lh}px;left:0;`;
      strips.left.textContent = block(
        0,
        sideCols,
        edgeRows,
        midRows,
        cols,
        rows,
      );

      strips.right.style.cssText = `top:${edgeRows * lh}px;right:0;`;
      strips.right.textContent = block(
        cols - sideCols,
        cols,
        edgeRows,
        midRows,
        cols,
        rows,
      );
    };

    draw();

    let raf = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(draw);
    });
  }
</script>
