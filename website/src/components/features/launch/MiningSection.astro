---
import { createTranslator, getLocaleFromUrl } from "@/utils/i18n";

const locale = getLocaleFromUrl(Astro.url.pathname);
const t = await createTranslator(locale);

const MINING_DOCS_URL = "https://docs.quantus.com/guides/mining/";
const ARROW_PATH =
  "M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z";
---

<section class="launch-mining">
  <h2 class="launch-mining-title">{t("launch.mining.title")}</h2>
  <p class="launch-mining-body">{t("launch.mining.body")}</p>

  <a
    class="launch-cta"
    href={MINING_DOCS_URL}
    target="_blank"
    rel="noopener"
    data-track="mining_docs_click"
    data-track-cta-location="launch"
  >
    {t("launch.mining.cta")}
    {/* On hover the arrow exits top-right and its copy enters bottom-left. */}
    <span class="launch-cta-icon" aria-hidden="true">
      <svg viewBox="0 0 14 15" fill="none" width="10" class="launch-cta-arrow">
        <path d={ARROW_PATH} fill="currentColor"></path>
      </svg>
      <svg
        viewBox="0 0 14 15"
        fill="none"
        width="10"
        class="launch-cta-arrow launch-cta-arrow-next"
      >
        <path d={ARROW_PATH} fill="currentColor"></path>
      </svg>
    </span>
  </a>
</section>

<style>
  .launch-mining {
    padding: 76px 56px 80px;
    text-align: center;
  }

  .launch-mining-title {
    margin: 0 0 16px;
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .launch-mining-body {
    margin: 0 0 40px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-content-70);
  }

  .launch-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 14px 14px 24px;
    border: 1px solid var(--color-content-20);
    background: var(--launch-cta-gradient);
    color: var(--color-content);
    font-family: var(--font-primary);
    font-size: 14.5px;
    font-weight: 400;
    letter-spacing: 0.005em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      color 0.3s ease;
  }

  .launch-cta:hover,
  .launch-cta:focus-visible {
    border-color: var(--color-flare);
    background: var(--launch-cta-gradient-hover);
  }

  .launch-cta:focus-visible {
    outline: 2px solid var(--color-content);
    outline-offset: 3px;
  }

  .launch-cta-icon {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    overflow: hidden;
    background: var(--color-flare);
    color: var(--color-void);
    transition: background-color 0.3s ease;
  }

  .launch-cta:hover .launch-cta-icon,
  .launch-cta:focus-visible .launch-cta-icon {
    background: var(--launch-flare-bright);
  }

  .launch-cta-arrow-next {
    position: absolute;
    transform: translate(-320%, 320%);
  }

  .launch-cta:hover .launch-cta-arrow:first-child,
  .launch-cta:focus-visible .launch-cta-arrow:first-child {
    transition: transform 0.3s ease-in-out;
    transform: translate(320%, -320%);
  }

  .launch-cta:hover .launch-cta-arrow-next,
  .launch-cta:focus-visible .launch-cta-arrow-next {
    transition: transform 0.3s ease-in-out 0.1s;
    transform: translate(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-cta,
    .launch-cta-icon,
    .launch-cta-arrow {
      transition: none !important;
    }
  }

  @media (max-width: 768px) {
    .launch-mining {
      padding: 56px 24px 60px;
    }

    .launch-cta {
      gap: 12px;
      padding: 12px 12px 12px 18px;
      font-size: 14px;
      text-align: left;
    }
  }
</style>
