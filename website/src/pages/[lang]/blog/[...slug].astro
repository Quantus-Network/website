---
import { type CollectionEntry, render } from "astro:content";
import BlogPost from "@/components/features/blog/BlogPost.astro";
import { PREFIXED_LOCALES, SUPPORTED_LOCALES } from "@/utils/i18n";
import { getBlogPosts, isBlogSlugPublished } from "@/utils/blog-posts";
import { relatedBlogPosts } from "@/utils/blog-categories";

export async function getStaticPaths() {
  const posts = await getBlogPosts();

  const paths = posts.map((post) => {
    const [lang, ...slugParts] = post.id.split("/");
    const slug = slugParts.join("/");

    // Normalize lang to match SUPPORTED_LOCALES case if possible
    const normalizedLang = SUPPORTED_LOCALES.find(
      (l) => l.toLowerCase() === lang.toLowerCase(),
    );

    return {
      params: { lang: normalizedLang || lang, slug },
      props: post,
    };
  });

  // Prefixed locales only — default English lives at unprefixed /blog/...
  return paths.filter(({ params }) =>
    PREFIXED_LOCALES.includes(params.lang as any),
  );
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;

const postLocale = post.id.split("/")[0];
const allPosts = await getBlogPosts(({ id }) => {
  return id.toLowerCase().startsWith(`${postLocale.toLowerCase()}/`);
});
const isUnpublishedPreview =
  import.meta.env.DEV && !isBlogSlugPublished(allPosts, post.id);

const relatedPosts = relatedBlogPosts(allPosts, post, 5);

const { Content } = await render(post);
---

<BlogPost
  {...post.data}
  relatedPosts={relatedPosts}
  isUnpublishedPreview={isUnpublishedPreview}
>
  <Content />
</BlogPost>
